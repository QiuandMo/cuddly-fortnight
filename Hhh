<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8" />
<title>system-login</title>
<style>
  html, body {
    margin: 0;
    height: 100%;
    background: #000;
    font-family: "Consolas", "Lucida Console", "Courier New", monospace;
    color: #c0c0c0;
  }
  .screen {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #000;
  }
  .login-box { width: 420px; }
  .login-line { display: flex; margin-bottom: 10px; }
  .login-line label { width: 100px; color: #888; }
  .login-line input {
    background: transparent; border: none; border-bottom: 1px solid #444;
    outline: none; color: #c0c0c0; font: inherit; flex: 1;
  }
  .error { color: #ff5555; font-size: 14px; margin-top: 6px; }
  .terminal {
    width: 100%; height: 100%; background: #000; color: #c0c0c0;
    padding: 10px; box-sizing: border-box; font-size: 15px; line-height: 1.45;
    overflow-y: auto; white-space: pre-wrap; word-break: break-word; display: none;
  }
  .prompt { color: #888; }
  .cursor {
    display: inline-block; width: 8px; height: 16px;
    border-bottom: 3px solid #c0c0c0; animation: blink 1s step-end infinite;
    vertical-align: bottom;
  }
  @keyframes blink { 50% { opacity: 0; } }
  .input-line { display: flex; position: sticky; bottom: 0; background: #000; }
  .input-line input {
    background: transparent; border: none; outline: none;
    color: #c0c0c0; font: inherit; flex: 1; caret-color: transparent;
  }
</style>
</head>
<body>

<div class="screen" id="loginScreen">
  <div class="login-box">
    <div class="login-line">
      <label>login:</label>
      <input type="text" id="username" autocomplete="off" />
    </div>
    <div class="login-line">
      <label>password:</label>
      <input type="password" id="password" autocomplete="off" />
    </div>
    <div class="error" id="error"></div>
  </div>
</div>

<div class="terminal" id="terminal"></div>

<script>
var loginScreen = document.getElementById("loginScreen");
var terminal = document.getElementById("terminal");
var usernameInput = document.getElementById("username");
var passwordInput = document.getElementById("password");
var error = document.getElementById("error");

function login() {
  var user = usernameInput.value.trim();
  var pass = passwordInput.value.trim();

  if (user === "sjswdkkfe@arg.cn" && pass === "360apws") {
    loginScreen.style.display = "none";
    terminal.style.display = "block";
    initTerminal();
  } else {
    loginScreen.style.display = "none";
    terminal.style.display = "block";
    initRestrictedTerminal(user);
  }
}

passwordInput.addEventListener("keydown", function(e) {
  if (e.key === "Enter") login();
});
usernameInput.addEventListener("keydown", function(e) {
  if (e.key === "Enter") passwordInput.focus();
});

/* ===== root 终端 ===== */
function initTerminal() {
  var marsChars = "莪噯伱①苼芣離伱湜ωǒ哋掵↘莪們哋嬡↗婼即婼離傷憾↘苡荖莪の杺呮潙伱儭噯伱芣玳價✿涙濕孒迗嬭丗鎅呮洧伱趉孒茬姒經荿塵";
  var hiddenChars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_@#/";
  var MARK = "3868303131";
  var glitchInterval = null;
  var protocolInterval = null;

  var inputLine = document.createElement("div");
  inputLine.className = "input-line";
  inputLine.innerHTML = '<span class="prompt">[kernel]</span><input type="text" id="input" autofocus /><span class="cursor"></span>';
  terminal.appendChild(inputLine);
  var input = document.getElementById("input");

  function scrollBottom() { terminal.scrollTop = terminal.scrollHeight; }
  function escapeHtml(text) { return text.replace(/</g, "&lt;").replace(/>/g, "&gt;"); }

  var startLine = document.createElement("div");
  startLine.innerHTML = '<span class="prompt">[kernel]</span> Stopping is just a matter of saying the word';
  terminal.insertBefore(startLine, inputLine);

  function startGlitch() {
    if (glitchInterval) return;
    glitchInterval = setInterval(function() {
      var markLine = document.createElement("div");
      markLine.textContent = MARK;
      terminal.insertBefore(markLine, inputLine);
      var line = "";
      for (var i = 0; i < 50; i++) {
        line += String.fromCharCode(33 + Math.random() * 94);
      }
      var glitchLine = document.createElement("div");
      glitchLine.textContent = line;
      terminal.insertBefore(glitchLine, inputLine);
      scrollBottom();
    }, 50);
  }

  function buildProtocol() {
    var protocol = "";
    var usefulCount = 0;
    while (usefulCount < 16) {
      for (var i = 0; i < 10; i++) {
        protocol += marsChars[Math.floor(Math.random() * marsChars.length)];
      }
      protocol += hiddenChars[Math.floor(Math.random() * hiddenChars.length)];
      usefulCount++;
    }
    return protocol;
  }

  function executeProtocolLoop() {
    var activeProtocol = buildProtocol();
    protocolInterval = setInterval(function() {
      var out = document.createElement("div");
      out.textContent = activeProtocol;
      terminal.insertBefore(out, inputLine);
      scrollBottom();
    }, 300);
  }

  function stopAll() {
    if (glitchInterval) clearInterval(glitchInterval);
    if (protocolInterval) clearInterval(protocolInterval);
    glitchInterval = null;
    protocolInterval = null;
    var msg = document.createElement("div");
    msg.textContent = "[kernel] Stream terminated.";
    terminal.insertBefore(msg, inputLine);
    scrollBottom();
  }

  input.addEventListener("keydown", function(e) {
    if (e.key === "Enter") {
      e.preventDefault();
      var cmd = input.value.trim();
      input.value = "";
      var echo = document.createElement("div");
      echo.innerHTML = '<span class="prompt">[kernel]</span> ' + escapeHtml(cmd);
      terminal.insertBefore(echo, inputLine);
      scrollBottom();
      if (cmd === "vfcgcyyiz/gg@xyui") startGlitch();
      else if (cmd === "ting") stopAll();
      else if (cmd === "3868303131") executeProtocolLoop();
      else {
        var err = document.createElement("div");
        err.textContent = "[kernel] unknown command: " + cmd;
        terminal.insertBefore(err, inputLine);
        scrollBottom();
      }
    }
  });
}

/* ===== 非 root 终端（循环报错） ===== */
function initRestrictedTerminal(user) {
  var inputLine = document.createElement("div");
  inputLine.className = "input-line";
  inputLine.innerHTML = '<span class="prompt">[' + user + ']</span><input type="text" id="input" autofocus /><span class="cursor"></span>';
  terminal.appendChild(inputLine);
  var input = document.getElementById("input");

  function scrollBottom() { terminal.scrollTop = terminal.scrollHeight; }
  function escapeHtml(text) { return text.replace(/</g, "&lt;").replace(/>/g, "&gt;"); }

  var startLine = document.createElement("div");
  startLine.innerHTML = '<span class="prompt">[' + user + ']</span> Stopping is just a matter of saying the word';
  terminal.insertBefore(startLine, inputLine);

  var errorInterval = setInterval(function() {
    var err = document.createElement("div");
    err.textContent = "[" + user + "] Permission denied. Access restricted.";
    terminal.insertBefore(err, inputLine);
    scrollBottom();
  }, 800);

  input.addEventListener("keydown", function(e) {
    if (e.key === "Enter") {
      e.preventDefault();
      var cmd = input.value.trim();
      input.value = "";
      var echo = document.createElement("div");
      echo.innerHTML = '<span class="prompt">[' + user + ']</span> ' + escapeHtml(cmd);
      terminal.insertBefore(echo, inputLine);
      scrollBottom();

      if (cmd === "ting") {
        clearInterval(errorInterval);
        var m1 = document.createElement("div");
        m1.textContent = "[" + user + "] Stream terminated.";
        terminal.insertBefore(m1, inputLine);
        scrollBottom();
      }
      if (cmd === "/tuicc") {
        clearInterval(errorInterval);
        var m2 = document.createElement("div");
        m2.textContent = "[" + user + "] session closed. returning to login...";
        terminal.insertBefore(m2, inputLine);
        scrollBottom();
        setTimeout(function() {
          terminal.style.display = "none";
          terminal.innerHTML = "";
          loginScreen.style.display = "flex";
          usernameInput.value = "";
          passwordInput.value = "";
          usernameInput.focus();
        }, 700);
      }
    }
  });
}
</script>

</body>
</html>